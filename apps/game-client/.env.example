# Client environment variables (Vite). All client vars must be prefixed VITE_.
# Copy to `.env.local` (git-ignored) to override locally; never put secrets here
# — anything with a VITE_ prefix is embedded in the public client bundle.

# Log level: debug | info | warn | error | silent
# Defaults to `debug` in development and `warn` in production when unset.
VITE_LOG_LEVEL=debug
